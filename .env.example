# =========================
# GEMINI (Google AI Studio)
# =========================
GEMINI_API_KEY=
# Free tier: gemini-2.0-flash often shows 0 quota — use gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite

# =========================
# SUPABASE
# =========================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 tokens only — ES256 tokens use JWKS from SUPABASE_URL automatically
SUPABASE_JWT_SECRET=

# =========================
# DATABASE (PostgreSQL)
# =========================
DATABASE_URL=

# =========================
# REDIS
# =========================
REDIS_URL=redis://localhost:6379

# =========================
# SECURITY
# =========================
SECRET_KEY=

# =========================
# ENVIRONMENT
# =========================
ENVIRONMENT=development

# =========================
# FRONTEND
# =========================
FRONTEND_URL=http://localhost:5173